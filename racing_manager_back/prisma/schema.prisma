  anchorElapsedAnchorMs         Int               @map("anchor_elapsed_anchor_ms")
  clientCapturedAt              DateTime          @map("client_captured_at") @db.Timestamptz(6)
  clientElapsedMs               Int               @map("client_elapsed_ms")
  capturedByUserId              String?           @map("captured_by_user_id") @db.Uuid
  capturedBy                    User?             @relation("TimingSplitCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  captureWorkstationInstanceId  String            @map("capture_workstation_instance_id")
  captureDeviceSequence         Int?              @map("capture_device_sequence")
  legacyMarkId                  String?           @unique @map("legacy_mark_id") @db.Uuid
  boundAttemptId                String?           @map("bound_attempt_id") @db.Uuid
  boundAttempt                  TimingSession?    @relation("TimingSplitBoundAttempt", fields: [boundAttemptId], references: [id], onDelete: Restrict)
  assignedAttemptId             String?           @map("assigned_attempt_id") @db.Uuid
  assignedAttempt               TimingSession?    @relation("TimingSplitAssignedAttempt", fields: [assignedAttemptId], references: [id], onDelete: Restrict)
  assignedAt                    DateTime?         @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId              String?           @map("assigned_by_user_id") @db.Uuid
  assignedWorkstationInstanceId String?           @map("assigned_workstation_instance_id")
  assignmentDeviceSequence      Int?              @map("assignment_device_sequence")
  offeredAttemptIds             Json?             @map("offered_attempt_ids")
  chosenByReferee               Boolean           @default(false) @map("chosen_by_referee")
  resolvedAt                    DateTime?         @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId              String?           @map("resolved_by_user_id") @db.Uuid
  resolvedWorkstationInstanceId String?           @map("resolved_workstation_instance_id")
  resolutionReason              String?           @map("resolution_reason")
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  candidates                    TimingAnonymousSplitCandidate[]
  pass                          TimingMark?       @relation("TimingSplitPass")

  @@index([eventId, state, captureInstant], map: "idx_timing_event_splits_event_state")
  @@map("timing_event_splits")
}

