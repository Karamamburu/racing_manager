model TimingMark {
  id                    String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId             String           @map("session_id") @db.Uuid
  session               TimingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clockEpochId          String?          @map("clock_epoch_id") @db.Uuid
  clockEpoch            TimingClockEpoch? @relation(fields: [clockEpochId], references: [id], onDelete: SetNull)
  enrollmentId          String?          @map("enrollment_id") @db.Uuid
  enrollment            Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  registrationId        String?          @map("registration_id") @db.Uuid
  registration          Registration?    @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  startNumber           Int?             @map("start_number")
  kind                  TimingMarkKind
  rawCapturedAt         DateTime         @map("raw_captured_at") @db.Timestamptz(6)
  rawElapsedMs          Int              @map("raw_elapsed_ms")
  officialAt            DateTime         @map("official_at") @db.Timestamptz(6)
  officialElapsedMs     Int              @map("official_elapsed_ms")
  lapNumber             Int?             @map("lap_number")
  status                TimingMarkStatus
  workstationInstanceId String           @map("workstation_instance_id")
  deviceSequence        Int?             @map("device_sequence")
  idempotencyKey        String           @map("idempotency_key")
  sourceSplitId         String?          @unique @map("source_split_id") @db.Uuid
  sourceSplit           TimingEventSplit? @relation("TimingSplitPass", fields: [sourceSplitId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // SQL-only check: a split-derived pass has no capture sequence
  // (source_split_id IS NULL OR device_sequence IS NULL). See
  // migrate_manual_timing_3_2026_11_14_split_sequence_guard.sql.
  @@index([sessionId, status], map: "idx_timing_marks_session_status")
  @@index([sessionId, enrollmentId, officialElapsedMs], map: "idx_timing_marks_session_enrollment_elapsed")
  @@index([sessionId, workstationInstanceId, deviceSequence], map: "idx_timing_marks_session_workstation_sequence")
  @@map("timing_marks")
}

