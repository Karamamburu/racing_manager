generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenderType {
  M
  F

  @@map("gender_type")
}

enum SportType {
  RUN
  SKI
  ROLLER_SKI
  BIKE

  @@map("sport_type")
}

enum EventKind {
  RACE
  TIME_TRIAL

  @@map("event_type")
}

enum EventStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("event_status")
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WITHDRAWN
  DNS
  DNF
  QQ
  DSQ

  @@map("registration_status")
}

enum ClassCompetitionStatus {
  DRAFT
  IN_PROGRESS
  DONE

  @@map("class_competition_status")
}

enum ClassHeatResultStatus {
  OK
  DNS
  DNF
  DSQ

  @@map("class_heat_result_status")
}

enum PersonalConsentDocumentType {
  PRIVACY_POLICY
  PERSONAL_DATA_CONSENT

  @@map("personal_consent_document_type")
}

enum PersonalConsentAction {
  GRANTED
  REVOKED

  @@map("personal_consent_action")
}

enum PersonalConsentSource {
  PROFILE_UPDATE
  REGISTRATION
  REVOKE

  @@map("personal_consent_source")
}

model User {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authentikId   String     @unique @map("authentik_id")
  userName      String     @unique @map("user_name")
  email         String?    @unique
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  gender        GenderType?
  birthDate     DateTime?  @map("birth_date") @db.Date
  city          String?
  district      String?
  team          String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles      UserRole[]
  createdEvents  Event[]
  createdNews    News[]
  registrations  Registration[]
  consentEvents  PersonalConsentEvent[]

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Track {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  locationCity String?  @map("location_city")
  description  String?
  mapLink      String?  @map("map_link")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events       Event[]
  news         News[]

  @@map("tracks")
}

model Event {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackId            String      @map("track_id") @db.Uuid
  track              Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name               String
  eventType          EventKind   @default(RACE) @map("event_type")
  sport              SportType
  eventDate          DateTime    @map("event_date") @db.Timestamptz(6)
  distanceKm         Decimal?    @map("distance_km") @db.Decimal(6, 2)
  description        String?
  mapLink            String?     @map("map_link")
  registrationOpen   DateTime?   @map("registration_open") @db.Timestamptz(6)
  registrationClose  DateTime?   @map("registration_close") @db.Timestamptz(6)
  status             EventStatus @default(PLANNED)
  createdById        String?     @map("created_by") @db.Uuid
  createdBy          User?       @relation(fields: [createdById], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  eventFormats       EventFormat[]
  registrations      Registration[]
  laps               EventLap[]
  classCompetitions  ClassCompetition[]

  @@index([trackId], map: "idx_events_track_id")
  @@index([eventDate], map: "idx_events_date")
  @@index([sport], map: "idx_events_sport")
  @@index([status], map: "idx_events_status")
  @@map("events")
}

model ParticipationFormat {
  id             Int            @id @default(autoincrement())
  sport          SportType
  code           String
  name           String
  sortOrder      Int            @default(0) @map("sort_order")
  eventFormats      EventFormat[]
  registrations     Registration[]
  classCompetitions ClassCompetition[]

  @@unique([sport, code])
  @@index([sport], map: "idx_participation_formats_sport")
  @@map("participation_formats")
}

model EventFormat {
  eventId  String              @map("event_id") @db.Uuid
  formatId Int                 @map("format_id")
  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  format   ParticipationFormat @relation(fields: [formatId], references: [id])

  @@id([eventId, formatId])
  @@index([formatId], map: "idx_event_formats_format_id")
  @@map("event_formats")
}

model Registration {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String?            @map("user_id") @db.Uuid
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName    String             @map("first_name")
  lastName     String             @map("last_name")
  gender       GenderType
  birthYear    Int                @map("birth_year")
  city         String?
  district     String?
  team         String?
  formatId     Int?               @map("format_id")
  format       ParticipationFormat? @relation(fields: [formatId], references: [id])
  startNumber  Int?               @map("start_number")
  status       RegistrationStatus @default(REGISTERED)
  note         String?
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  result       Result?
  heatTimes    ClassHeatTime[]

  @@index([eventId], map: "idx_registrations_event_id")
  @@index([userId], map: "idx_registrations_user_id")
  @@index([status], map: "idx_registrations_status")
  @@index([formatId], map: "idx_registrations_format_id")
  // Guest person uniqueness is an expression index in SQL:
  // idx_registrations_event_person_active (user_id IS NULL)
  @@map("registrations")
}

model EventLap {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId    String      @map("event_id") @db.Uuid
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lapNumber  Int         @map("lap_number")
  distanceKm Decimal     @map("distance_km") @db.Decimal(6, 2)
  resultLaps ResultLap[]

  @@unique([eventId, lapNumber])
  @@index([eventId], map: "idx_event_laps_event_id")
  @@map("event_laps")
}

model ClassCompetition {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId          String                 @map("event_id") @db.Uuid
  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formatId         Int?                   @map("format_id")
  format           ParticipationFormat?   @relation(fields: [formatId], references: [id])
  gender           GenderType
  cmsCompetitionId String                 @unique @map("cms_competition_id") @db.Uuid
  status           ClassCompetitionStatus @default(DRAFT)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  heatTimes        ClassHeatTime[]

  @@unique([eventId, formatId, gender])
  @@index([eventId], map: "idx_class_competitions_event_id")
  @@map("class_competitions")
}

model ClassHeatTime {
  id                 String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classCompetitionId String                @map("class_competition_id") @db.Uuid
  classCompetition   ClassCompetition      @relation(fields: [classCompetitionId], references: [id], onDelete: Cascade)
  stageId            String                @map("stage_id")
  heatNumber         Int                   @map("heat_number")
  registrationId     String                @map("registration_id") @db.Uuid
  registration       Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  timeMilliseconds   Int?                  @map("time_milliseconds")
  status             ClassHeatResultStatus @default(OK)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([classCompetitionId, stageId, heatNumber, registrationId])
  @@index([classCompetitionId, stageId], map: "idx_class_heat_times_stage")
  @@index([registrationId], map: "idx_class_heat_times_registration_id")
  @@map("class_heat_times")
}

model Result {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registrationId   String       @unique @map("registration_id") @db.Uuid
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  timeMilliseconds Int          @map("time_milliseconds")
  place            Int?
  recordedAt       DateTime     @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  laps             ResultLap[]

  @@map("results")
}

model ResultLap {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  resultId         String   @map("result_id") @db.Uuid
  result           Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventLapId       String   @map("event_lap_id") @db.Uuid
  eventLap         EventLap @relation(fields: [eventLapId], references: [id], onDelete: Cascade)
  timeMilliseconds Int      @map("time_milliseconds")
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resultId, eventLapId])
  @@index([resultId], map: "idx_result_laps_result_id")
  @@index([eventLapId], map: "idx_result_laps_event_lap_id")
  @@map("result_laps")
}

model PersonalConsentDocument {
  id          String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type        PersonalConsentDocumentType
  version     String
  title       String
  text        String
  publishedAt DateTime                     @map("published_at") @db.Timestamptz(6)
  events      PersonalConsentEvent[]

  @@unique([type, version])
  @@map("personal_consent_documents")
}

model PersonalConsentEvent {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentId    String                    @map("document_id") @db.Uuid
  document      PersonalConsentDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  userId        String                    @map("user_id") @db.Uuid
  user          User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  action        PersonalConsentAction
  source        PersonalConsentSource
  userFirstName String                    @map("user_first_name")
  userLastName  String                    @map("user_last_name")
  userBirthDate DateTime?                 @map("user_birth_date") @db.Date
  occurredAt    DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ip            String?
  userAgent     String?                   @map("user_agent")

  @@index([userId], map: "idx_personal_consent_events_user_id")
  @@index([documentId], map: "idx_personal_consent_events_document_id")
  @@map("personal_consent_events")
}

model News {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackId       String   @map("track_id") @db.Uuid
  track         Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title         String
  body          String
  coverImageUrl String?  @map("cover_image_url")
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdById   String?  @map("created_by") @db.Uuid
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([trackId], map: "idx_news_track_id")
  @@index([publishedAt], map: "idx_news_published_at")
  @@map("news")
}
