generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenderType {
  M
  F

  @@map("gender_type")
}

enum SportType {
  RUN
  SKI
  ROLLER_SKI
  BIKE

  @@map("sport_type")
}

enum EventKind {
  RACE
  TIME_TRIAL

  @@map("event_type")
}

enum EventStatus {
  PLANNED
  DONE
  CANCELLED

  @@map("event_status")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@map("registration_status")
}

model User {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authentikId   String     @unique @map("authentik_id")
  userName      String     @unique @map("user_name")
  email         String?    @unique
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  gender        GenderType?
  birthDate     DateTime?  @map("birth_date") @db.Date
  city          String?
  district      String?
  team          String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles     UserRole[]
  createdEvents Event[]
  registrations Registration[]

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Track {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  locationCity String?  @map("location_city")
  description  String?
  mapLink      String?  @map("map_link")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events       Event[]

  @@map("tracks")
}

model Event {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackId            String      @map("track_id") @db.Uuid
  track              Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name               String
  eventType          EventKind   @default(RACE) @map("event_type")
  sport              SportType
  eventDate          DateTime    @map("event_date") @db.Date
  distanceKm         Decimal?    @map("distance_km") @db.Decimal(6, 2)
  description        String?
  registrationOpen   DateTime?   @map("registration_open") @db.Timestamptz(6)
  registrationClose  DateTime?   @map("registration_close") @db.Timestamptz(6)
  status             EventStatus @default(PLANNED)
  createdById        String?     @map("created_by") @db.Uuid
  createdBy          User?       @relation(fields: [createdById], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  registrations      Registration[]

  @@index([trackId], map: "idx_events_track_id")
  @@index([eventDate], map: "idx_events_date")
  @@index([sport], map: "idx_events_sport")
  @@index([status], map: "idx_events_status")
  @@map("events")
}

model Registration {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String             @map("user_id") @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       RegistrationStatus @default(PENDING)
  note         String?
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, userId])
  @@index([eventId], map: "idx_registrations_event_id")
  @@index([userId], map: "idx_registrations_user_id")
  @@index([status], map: "idx_registrations_status")
  @@map("registrations")
}
