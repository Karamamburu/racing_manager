generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenderType {
  M
  F

  @@map("gender_type")
}

enum SportType {
  RUN
  SKI
  ROLLER_SKI
  BIKE

  @@map("sport_type")
}

enum EventKind {
  RACE
  TIME_TRIAL

  @@map("event_type")
}

enum EventStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("event_status")
}

enum StartPurposeType {
  CUP_RACE
  CONTROL_TRAINING

  @@map("start_purpose_type")
}

enum StartRouteColor {
  BLUE
  ORANGE
  CYAN
  RED
  MAGENTA
  YELLOW

  @@map("start_route_color")
}

enum EnrollmentStatus {
  REGISTERED
  WITHDRAWN

  @@map("enrollment_status")
}

enum ResultOutcome {
  FINISHED
  DNS
  DNF
  DSQ

  @@map("result_outcome")
}

enum AgeSplitSectionKind {
  BASE_GROUP
  PRESET

  @@map("age_split_section_kind")
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WITHDRAWN
  DNS
  DNF
  QQ
  NQ
  DSQ
  FINISHED

  @@map("registration_status")
}

enum ClassCompetitionStatus {
  DRAFT
  IN_PROGRESS
  DONE

  @@map("class_competition_status")
}

enum ClassHeatResultStatus {
  OK
  DNS
  DNF
  DSQ

  @@map("class_heat_result_status")
}

enum PersonalConsentDocumentType {
  PRIVACY_POLICY
  PERSONAL_DATA_CONSENT
  PERSONAL_DATA_DISTRIBUTION_CONSENT

  @@map("personal_consent_document_type")
}

enum PersonalConsentAction {
  GRANTED
  REVOKED

  @@map("personal_consent_action")
}

enum PersonalConsentSource {
  PROFILE_UPDATE
  REGISTRATION
  REVOKE

  @@map("personal_consent_source")
}

enum TimingSessionStatus {
  RUNNING
  COMPLETED
  INCOMPLETE
  CANCELLED

  @@map("timing_session_status")
}

enum TimingAttemptKind {
  CATEGORY
  HEAT

  @@map("timing_attempt_kind")
}

enum TimingMarkKind {
  PASS
  PENDING_FINISH
  ANONYMOUS_SPLIT

  @@map("timing_mark_kind")
}

enum TimingMarkStatus {
  BOUND
  PENDING
  CANCELLED

  @@map("timing_mark_status")
}

enum TimingReceiptStatus {
  APPLIED
  REJECTED

  @@map("timing_receipt_status")
}

enum TimingSplitState {
  QUEUED
  ASSIGNED
  UNDONE
  CANCELLED

  @@map("timing_split_state")
}

enum TimingCaptureOrigin {
  CAPTURE
  SPLIT_ASSIGN

  @@map("timing_capture_origin")
}

model User {
  id            String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authentikId   String                 @unique @map("authentik_id")
  userName      String                 @unique @map("user_name")
  email         String?                @unique
  firstName     String?                @map("first_name")
  lastName      String?                @map("last_name")
  gender        GenderType?
  birthDate     DateTime?              @map("birth_date") @db.Date
  city          String?
  district      String?
  team          String?
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles     UserRole[]
  createdEvents Event[]
  createdNews   News[]
  registrations Registration[]
  consentEvents PersonalConsentEvent[]

  timingSessionsStarted   TimingSession[]     @relation("TimingSessionStartedBy")
  timingSessionsClosed    TimingSession[]     @relation("TimingSessionClosedBy")
  timingClockEpochsOpened TimingClockEpoch[]
  timingCaptureLocksHeld  TimingCaptureLock[]
  timingAuditEntries      TimingAudit[]
  timingSplitsCaptured    TimingEventSplit[]  @relation("TimingSplitCapturedBy")
  timingEventAuditEntries TimingEventAudit[]  @relation("TimingEventAuditActor")

  @@map("users")
}

model Role {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Track {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  locationCity String?  @map("location_city")
  description  String?
  mapLink      String?  @map("map_link")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events       Event[]
  news         News[]

  @@map("tracks")
}

model Event {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  trackId            String             @map("track_id") @db.Uuid
  track              Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name               String
  eventType          EventKind          @default(RACE) @map("event_type")
  sport              SportType
  eventDate          DateTime           @map("event_date") @db.Timestamptz(6)
  distanceKm         Decimal?           @map("distance_km") @db.Decimal(6, 2)
  description        String?
  mapLink            String?            @map("map_link")
  registrationOpen   DateTime?          @map("registration_open") @db.Timestamptz(6)
  registrationClose  DateTime?          @map("registration_close") @db.Timestamptz(6)
  status             EventStatus        @default(PLANNED)
  createdById        String?            @map("created_by") @db.Uuid
  createdBy          User?              @relation(fields: [createdById], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  eventFormats       EventFormat[]
  registrations      Registration[]
  laps               EventLap[]
  starts             Start[]
  classCompetitions  ClassCompetition[]
  categoryFinishes   CategoryFinish[]
  ageSplitSections   AgeSplitSection[]
  ageSplitCategories AgeSplitCategory[]
  timingSessions     TimingSession[]
  timingCaptureLock  TimingCaptureLock?
  timingEventSplits  TimingEventSplit[]
  timingEventReceipts TimingEventCaptureReceipt[]
  timingEventAudit   TimingEventAudit[]

  @@index([trackId], map: "idx_events_track_id")
  @@index([eventDate], map: "idx_events_date")
  @@index([sport], map: "idx_events_sport")
  @@index([status], map: "idx_events_status")
  @@map("events")
}

model ParticipationFormat {
  id                 Int                @id @default(autoincrement())
  sport              SportType
  code               String
  name               String
  sortOrder          Int                @default(0) @map("sort_order")
  eventFormats       EventFormat[]
  registrations      Registration[]
  startFormats       StartFormat[]
  classCompetitions  ClassCompetition[]
  categoryFinishes   CategoryFinish[]
  ageSplitSections   AgeSplitSection[]
  ageSplitCategories AgeSplitCategory[]
  timingSessions     TimingSession[]

  @@unique([sport, code])
  @@index([sport], map: "idx_participation_formats_sport")
  @@map("participation_formats")
}

model EventFormat {
  eventId  String              @map("event_id") @db.Uuid
  formatId Int                 @map("format_id")
  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  format   ParticipationFormat @relation(fields: [formatId], references: [id])

  @@id([eventId, formatId])
  @@index([formatId], map: "idx_event_formats_format_id")
  @@map("event_formats")
}

model Registration {
  id           String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId      String               @map("event_id") @db.Uuid
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String?              @map("user_id") @db.Uuid
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName    String               @map("first_name")
  lastName     String               @map("last_name")
  gender       GenderType
  birthYear    Int                  @map("birth_year")
  city         String?
  district     String?
  team         String?
  formatId     Int?                 @map("format_id")
  format       ParticipationFormat? @relation(fields: [formatId], references: [id])
  startNumber  Int?                 @map("start_number")
  status       RegistrationStatus   @default(REGISTERED)
  note         String?
  registeredAt DateTime             @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  result       Result?
  enrollments  Enrollment[]
  heatTimes    ClassHeatTime[]

  timingSessionParticipants TimingSessionParticipant[]
  timingMarks               TimingMark[]

  @@unique([id, eventId], map: "uq_registrations_id_event")
  @@index([eventId], map: "idx_registrations_event_id")
  @@index([userId], map: "idx_registrations_user_id")
  @@index([status], map: "idx_registrations_status")
  @@index([formatId], map: "idx_registrations_format_id")
  // Guest person uniqueness is an expression index in SQL:
  // idx_registrations_event_person_active (user_id IS NULL)
  @@map("registrations")
}

model EventLap {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lapNumber    Int                @map("lap_number")
  distanceKm   Decimal            @map("distance_km") @db.Decimal(6, 2)
  resultLaps   ResultLap[]
  heatLapTimes ClassHeatLapTime[]

  @@unique([eventId, lapNumber])
  @@index([eventId], map: "idx_event_laps_event_id")
  @@map("event_laps")
}

model Start {
  id                       String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId                  String             @map("event_id") @db.Uuid
  event                    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purposeType              StartPurposeType   @map("purpose_type")
  lapCount                 Int                @map("lap_count")
  lapLengthMeters          Int                @map("lap_length_meters")
  displayName              String?            @map("display_name")
  routeColor               StartRouteColor?   @map("route_color")
  sortOrder                Int                @map("sort_order")
  legacyEffectiveDistanceM Int?               @map("legacy_effective_distance_m")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  formats                  StartFormat[]
  enrollments              Enrollment[]
  categoryFinishes         CategoryFinish[]
  ageSplitSections         AgeSplitSection[]
  ageSplitCategories       AgeSplitCategory[]
  classCompetitions        ClassCompetition[]
  timingSessions           TimingSession[]

  @@unique([id, eventId], map: "uq_starts_id_event")
  @@unique([eventId, sortOrder], map: "uq_starts_event_sort_order")
  @@index([eventId], map: "idx_starts_event_id")
  @@map("starts")
}

model StartFormat {
  startId  String              @map("start_id") @db.Uuid
  formatId Int                 @map("format_id")
  start    Start               @relation(fields: [startId], references: [id], onDelete: Cascade)
  format   ParticipationFormat @relation(fields: [formatId], references: [id])

  @@id([startId, formatId])
  @@index([formatId], map: "idx_start_formats_format_id")
  @@map("start_formats")
}

model Enrollment {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  registrationId String           @map("registration_id") @db.Uuid
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  startId        String           @map("start_id") @db.Uuid
  start          Start            @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId       Int              @map("format_id")
  status         EnrollmentStatus @default(REGISTERED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  result         Result?

  timingSessionParticipants TimingSessionParticipant[]
  timingMarks               TimingMark[]

  @@unique([registrationId, startId], map: "uq_enrollments_registration_start")
  @@index([eventId], map: "idx_enrollments_event_id")
  @@index([startId], map: "idx_enrollments_start_id")
  @@index([status], map: "idx_enrollments_status")
  @@map("enrollments")
}

model ClassCompetition {
  id                      String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId                 String                 @map("event_id") @db.Uuid
  event                   Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startId                 String?                @map("start_id") @db.Uuid
  start                   Start?                 @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId                Int?                   @map("format_id")
  format                  ParticipationFormat?   @relation(fields: [formatId], references: [id])
  gender                  GenderType
  sectionId               String?                @map("section_id")
  sectionKind             String?                @map("section_kind")
  targetKey               String                 @default("WHOLE") @map("target_key")
  targetGroupIds          String[]               @default([]) @map("target_group_ids")
  targetWholeCategory     Boolean                @default(true) @map("target_whole_category")
  frozenTitle             String?                @map("frozen_title")
  frozenSubtitle          String?                @map("frozen_subtitle")
  frozenYoungestBound     Int?                   @map("frozen_youngest_bound")
  frozenMemberBounds      Int[]                  @default([]) @map("frozen_member_bounds")
  frozenSectionNumber     Int?                   @map("frozen_section_number")
  capturedEnrollmentIds   String[]               @default([]) @map("captured_enrollment_ids")
  capturedRegistrationIds String[]               @default([]) @map("captured_registration_ids")
  cmsCompetitionId        String                 @unique @map("cms_competition_id") @db.Uuid
  status                  ClassCompetitionStatus @default(DRAFT)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  heatTimes               ClassHeatTime[]
  timingSessions          TimingSession[]

  @@unique([eventId, startId, formatId, gender, targetKey])
  @@index([eventId], map: "idx_class_competitions_event_id")
  @@index([startId], map: "idx_class_competitions_start_id")
  @@map("class_competitions")
}

model CategoryFinish {
  id         String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId    String               @map("event_id") @db.Uuid
  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startId    String?              @map("start_id") @db.Uuid
  start      Start?               @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId   Int?                 @map("format_id")
  format     ParticipationFormat? @relation(fields: [formatId], references: [id])
  gender     GenderType
  finishedAt DateTime             @default(now()) @map("finished_at") @db.Timestamptz(6)

  @@unique([eventId, startId, formatId, gender], map: "uq_category_finishes_start")
  @@unique([eventId, formatId, gender])
  @@index([eventId], map: "idx_category_finishes_event_id")
  @@index([startId], map: "idx_category_finishes_start_id")
  @@map("category_finishes")
}

model AgeSplitSection {
  eventId     String              @map("event_id") @db.Uuid
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startId     String              @map("start_id") @db.Uuid
  start       Start               @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId    Int                 @map("format_id")
  format      ParticipationFormat @relation(fields: [formatId], references: [id])
  gender      GenderType
  sectionId   String              @map("section_id")
  sectionKind AgeSplitSectionKind @map("section_kind")
  sortOrder   Int                 @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([eventId, startId, formatId, gender, sectionId])
  @@unique([eventId, startId, formatId, gender, sortOrder], map: "uq_age_split_sections_order")
  @@index([eventId], map: "idx_age_split_sections_event_id")
  @@map("age_split_sections")
}

model AgeSplitCategory {
  eventId        String              @map("event_id") @db.Uuid
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startId        String              @map("start_id") @db.Uuid
  start          Start               @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId       Int                 @map("format_id")
  format         ParticipationFormat @relation(fields: [formatId], references: [id])
  gender         GenderType
  categoryNumber Int                 @map("category_number")
  groupId        String              @map("group_id")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([eventId, startId, formatId, gender, categoryNumber, groupId])
  @@unique([eventId, startId, formatId, gender, groupId], map: "uq_age_split_categories_group")
  @@index([eventId], map: "idx_age_split_categories_event_id")
  @@map("age_split_categories")
}

model ClassHeatTime {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classCompetitionId  String                @map("class_competition_id") @db.Uuid
  classCompetition    ClassCompetition      @relation(fields: [classCompetitionId], references: [id], onDelete: Cascade)
  stageId             String                @map("stage_id")
  heatNumber          Int                   @map("heat_number")
  registrationId      String                @map("registration_id") @db.Uuid
  registration        Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  timeMilliseconds    Int?                  @map("time_milliseconds")
  status              ClassHeatResultStatus @default(OK)
  qualificationStatus RegistrationStatus?   @map("qualification_status")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  laps                ClassHeatLapTime[]

  @@unique([classCompetitionId, stageId, heatNumber, registrationId])
  @@index([classCompetitionId, stageId], map: "idx_class_heat_times_stage")
  @@index([registrationId], map: "idx_class_heat_times_registration_id")
  @@map("class_heat_times")
}

model ClassHeatLapTime {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  classHeatTimeId  String        @map("class_heat_time_id") @db.Uuid
  classHeatTime    ClassHeatTime @relation(fields: [classHeatTimeId], references: [id], onDelete: Cascade)
  eventLapId       String        @map("event_lap_id") @db.Uuid
  eventLap         EventLap      @relation(fields: [eventLapId], references: [id], onDelete: Cascade)
  timeMilliseconds Int           @map("time_milliseconds")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([classHeatTimeId, eventLapId])
  @@index([classHeatTimeId], map: "idx_class_heat_lap_times_heat_time_id")
  @@index([eventLapId], map: "idx_class_heat_lap_times_event_lap_id")
  @@map("class_heat_lap_times")
}

model Result {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registrationId   String         @unique @map("registration_id") @db.Uuid
  registration     Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  enrollmentId     String?        @unique @map("enrollment_id") @db.Uuid
  enrollment       Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  outcome          ResultOutcome?
  timeMilliseconds Int?           @map("time_milliseconds")
  place            Int?
  recordedAt       DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  timingSessionId  String?        @map("timing_session_id") @db.Uuid
  timingSession    TimingSession? @relation(fields: [timingSessionId], references: [id], onDelete: SetNull)
  laps             ResultLap[]
  splits           ResultSplit[]

  @@index([timingSessionId], map: "idx_results_timing_session_id")
  @@map("results")
}

model ResultLap {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  resultId         String   @map("result_id") @db.Uuid
  result           Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  eventLapId       String   @map("event_lap_id") @db.Uuid
  eventLap         EventLap @relation(fields: [eventLapId], references: [id], onDelete: Cascade)
  timeMilliseconds Int      @map("time_milliseconds")
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resultId, eventLapId])
  @@index([resultId], map: "idx_result_laps_result_id")
  @@index([eventLapId], map: "idx_result_laps_event_lap_id")
  @@map("result_laps")
}

model ResultSplit {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  resultId     String   @map("result_id") @db.Uuid
  result       Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  lapNumber    Int      @map("lap_number")
  lapTimeMs    Int      @map("lap_time_ms")
  cumulativeMs Int      @map("cumulative_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resultId, lapNumber], map: "uq_result_splits_result_lap")
  @@index([resultId], map: "idx_result_splits_result_id")
  @@map("result_splits")
}

model TimingSession {
  id                 String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId            String                     @map("event_id") @db.Uuid
  event              Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startId            String                     @map("start_id") @db.Uuid
  start              Start                      @relation(fields: [startId], references: [id], onDelete: Cascade)
  formatId           Int                        @map("format_id")
  format             ParticipationFormat        @relation(fields: [formatId], references: [id])
  gender             GenderType
  attemptNumber      Int                        @map("attempt_number")
  // A category attempt keeps the three heat fields null; a heat attempt sets
  // all three. The paired check constraint is SQL-only.
  attemptKind        TimingAttemptKind          @default(CATEGORY) @map("attempt_kind")
  classCompetitionId String?                    @map("class_competition_id") @db.Uuid
  classCompetition   ClassCompetition?          @relation(fields: [classCompetitionId], references: [id], onDelete: Cascade)
  stageId            String?                    @map("stage_id")
  heatNumber         Int?                       @map("heat_number")
  status             TimingSessionStatus        @default(RUNNING)
  officialStartedAt  DateTime                   @map("official_started_at") @db.Timestamptz(6)
  clientStartedAt    DateTime                   @map("client_started_at") @db.Timestamptz(6)
  startedByUserId    String?                    @map("started_by_user_id") @db.Uuid
  startedBy          User?                      @relation("TimingSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  closedAt           DateTime?                  @map("closed_at") @db.Timestamptz(6)
  closedByUserId     String?                    @map("closed_by_user_id") @db.Uuid
  closedBy           User?                      @relation("TimingSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closureReport      Json?                      @map("closure_report")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants       TimingSessionParticipant[]
  clockEpochs        TimingClockEpoch[]
  marks              TimingMark[]
  receipts           TimingCaptureReceipt[]
  auditEntries       TimingAudit[]
  results            Result[]
  splitAnchors       TimingEventSplit[]       @relation("TimingSplitAnchorAttempt")
  splitBound         TimingEventSplit[]       @relation("TimingSplitBoundAttempt")
  splitAssigned      TimingEventSplit[]       @relation("TimingSplitAssignedAttempt")
  splitCandidates    TimingAnonymousSplitCandidate[]

  // The SQL migration also adds composite foreign keys to
  // starts(id, event_id) and start_formats(start_id, format_id). Prisma
  // cannot carry both those and the single-column relations above over the
  // same fields, so they stay SQL-only.
  // The category attempt uniqueness is a partial index, SQL only:
  // uq_timing_sessions_category_attempt ON (event_id, start_id, format_id,
  // gender, attempt_number) WHERE attempt_kind = 'CATEGORY'. Prisma has no
  // partial index, so no @@unique here: a full unique would make a heat
  // attempt collide with the category attempt of the same race.
  //
  // Partial unique indexes, SQL only:
  // uq_timing_sessions_running_category ON (event_id, start_id, format_id, gender)
  //   WHERE status = 'RUNNING' AND attempt_kind = 'CATEGORY';
  // uq_timing_sessions_running_heat ON (class_competition_id, stage_id, heat_number)
  //   WHERE status = 'RUNNING' AND attempt_kind = 'HEAT'.
  //
  // Heat attempt identity. SQL creates the partial heat index
  // uq_timing_sessions_heat_attempt over the same four columns with
  // WHERE attempt_kind = 'HEAT'; this Prisma unique exists so the client has
  // the compound key, and it is harmless for category rows because all four
  // values are null there.
  @@unique([classCompetitionId, stageId, heatNumber, attemptNumber], map: "uq_timing_sessions_heat_attempt")
  @@index([eventId], map: "idx_timing_sessions_event_id")
  @@index([classCompetitionId, stageId], map: "idx_timing_sessions_class_competition_stage")
  @@map("timing_sessions")
}

