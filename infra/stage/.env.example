# Stage single-VPS secrets — use different values from production.
DOMAIN=stage.example.com
AUTH_DOMAIN=auth.stage.example.com
MEDIA_DOMAIN=media.stage.example.com

PUBLIC_SCHEME=http
TLS_ENABLED=false
SESSION_COOKIE_SECURE=false

POSTGRES_MAIN_USER=racing
POSTGRES_MAIN_PASSWORD=change-me-stage-main
POSTGRES_MAIN_DB=racing_manager

POSTGRES_CMS_USER=cms
POSTGRES_CMS_PASSWORD=change-me-stage-cms
POSTGRES_CMS_DB=competition_managment

POSTGRES_AUTHENTIK_USER=authentik
POSTGRES_AUTHENTIK_PASSWORD=change-me-stage-authentik
POSTGRES_AUTHENTIK_DB=authentik

# Timeweb Cloud S3 (same as prod or a separate bucket)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=c9a28321-c009-4297-815a-1c877cae7938
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/c9a28321-c009-4297-815a-1c877cae7938
S3_CREATE_BUCKET=false
S3_PUBLIC_READ=true
S3_PROXY_HOST=s3.twcstorage.ru

SESSION_SECRET=change-me-stage-session-secret
AUTHENTIK_SECRET_KEY=change-me-stage-authentik-secret

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_APP_SLUG=racing-manager

GRAFANA_LOKI_URL=https://logs-prod-025.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_TOKEN=

CERTBOT_EMAIL=ops@example.com
