# Public hostnames (DNS A → app public IP). Use one cert covering all three.
DOMAIN=example.com
AUTH_DOMAIN=auth.example.com
MEDIA_DOMAIN=media.example.com

# Private IP of the data VPS (reachable only from app)
DATA_HOST=10.0.0.2

# http until certs exist; init-certs.sh sets PUBLIC_SCHEME=https and TLS_ENABLED=true
PUBLIC_SCHEME=http
TLS_ENABLED=false
SESSION_COOKIE_SECURE=false

# Postgres credentials (must match infra/data/.env)
POSTGRES_MAIN_USER=racing
POSTGRES_MAIN_PASSWORD=change-me-main
POSTGRES_MAIN_DB=racing_manager

POSTGRES_CMS_USER=cms
POSTGRES_CMS_PASSWORD=change-me-cms
POSTGRES_CMS_DB=competition_managment

POSTGRES_AUTHENTIK_USER=authentik
POSTGRES_AUTHENTIK_PASSWORD=change-me-authentik
POSTGRES_AUTHENTIK_DB=authentik

# Timeweb Cloud S3 (https://timeweb.cloud/docs/s3-storage)
# Panel → S3 → Access Key / Secret Key. Bucket must already exist.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=c9a28321-c009-4297-815a-1c877cae7938
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/c9a28321-c009-4297-815a-1c877cae7938
S3_CREATE_BUCKET=false
# Prefer making the bucket public in Timeweb UI; API policy apply is best-effort.
S3_PUBLIC_READ=true
# Host used by nginx media.* reverse-proxy (usually same as S3 endpoint host)
S3_PROXY_HOST=s3.twcstorage.ru

# API session + Authentik
SESSION_SECRET=change-me-long-random-session-secret
AUTHENTIK_SECRET_KEY=change-me-long-random-authentik-secret

# OIDC application (create in Authentik UI — see AUTHENTIK.md)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_APP_SLUG=racing-manager

# Grafana Cloud Loki
GRAFANA_LOKI_URL=https://logs-prod-025.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_TOKEN=

# Let's Encrypt
CERTBOT_EMAIL=ops@example.com
