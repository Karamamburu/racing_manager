# Public hostnames (DNS A → app public IP). Use one cert covering all three.
DOMAIN=example.com
AUTH_DOMAIN=auth.example.com
MEDIA_DOMAIN=media.example.com

# Private IP of the data VPS (reachable only from app)
DATA_HOST=10.0.0.2

# Set true after ./scripts/init-certs.sh succeeds
TLS_ENABLED=false

# Shared secrets (must match infra/data/.env)
POSTGRES_MAIN_USER=racing
POSTGRES_MAIN_PASSWORD=change-me-main
POSTGRES_MAIN_DB=racing_manager

POSTGRES_CMS_USER=cms
POSTGRES_CMS_PASSWORD=change-me-cms
POSTGRES_CMS_DB=competition_managment

POSTGRES_AUTHENTIK_USER=authentik
POSTGRES_AUTHENTIK_PASSWORD=change-me-authentik
POSTGRES_AUTHENTIK_DB=authentik

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-min-16chars
MINIO_BUCKET=racing-manager-media
S3_REGION=us-east-1

# API session + Authentik
SESSION_SECRET=change-me-long-random-session-secret
# Set false only while testing over plain HTTP before init-certs.sh
SESSION_COOKIE_SECURE=true
AUTHENTIK_SECRET_KEY=change-me-long-random-authentik-secret

# OIDC application (create in Authentik UI — see AUTHENTIK.md)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_APP_SLUG=racing-manager

# Grafana Cloud Loki
GRAFANA_LOKI_URL=https://logs-prod-025.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_TOKEN=

# Let's Encrypt
CERTBOT_EMAIL=ops@example.com
