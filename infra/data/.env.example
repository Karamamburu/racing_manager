# Bind Postgres/MinIO only on the private NIC (never 0.0.0.0 in production).
# Example: DATA_BIND_ADDRESS=10.0.0.2
DATA_BIND_ADDRESS=127.0.0.1

POSTGRES_MAIN_USER=racing
POSTGRES_MAIN_PASSWORD=change-me-main
POSTGRES_MAIN_DB=racing_manager

POSTGRES_CMS_USER=cms
POSTGRES_CMS_PASSWORD=change-me-cms
POSTGRES_CMS_DB=competition_managment

POSTGRES_AUTHENTIK_USER=authentik
POSTGRES_AUTHENTIK_PASSWORD=change-me-authentik
POSTGRES_AUTHENTIK_DB=authentik

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-min-16chars
MINIO_BUCKET=racing-manager-media

# Grafana Cloud Loki (same stack as local observability)
GRAFANA_LOKI_URL=https://logs-prod-025.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_TOKEN=
